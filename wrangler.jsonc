{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "match-manager-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "match-manager",
      "database_id": "d327028d-000a-4208-8f34-00203647d244"
    }
  ],
  "routes": [
    {
      "pattern": "kbottsson.com/*",
      "zone_name": "kbottsson.com"
    },
    {
      "pattern": "www.kbottsson.com/*",
      "zone_name": "kbottsson.com"
    },
    {
      "pattern": "api.kbottsson.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "vars": {
    "APP_URL": "https://kbottsson.com"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
