{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "match-manager-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "match-manager",
      "database_id": "d327028d-000a-4208-8f34-00203647d244"
    }
  ],
  "routes": [
    {
      "pattern": "api.kbottsson.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}
